{
  "name": "@runecraft/companion",
  "version": "0.1.0",
  "description": "Runecraft Companion \u2014 the multi-agent harness that equips Pi with guards, verification, evals, memory and coded routing.",
  "license": "MIT",
  "author": "Runecraft",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "harness",
    "companion",
    "subagents",
    "taskflow",
    "goal-loop-audit",
    "pr-review"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runecraftai/harness.git"
  },
  "homepage": "https://github.com/runecraftai/harness/tree/main/packages/harness#readme",
  "bugs": {
    "url": "https://github.com/runecraftai/harness/issues"
  },
  "files": [
    "bin/",
    "src/",
    "extensions/",
    "docs/",
    "skills/",
    "assets/",
    "agents/",
    "claude-agents/",
    "chains/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepack": "node ./scripts/prepack.mjs",
    "generate:versions": "node ./scripts/gen-versions.mjs",
    "test": "bun test --preload ./test/eval/setup.ts --preload ./test/guards/setup.ts --preload ./test/verify/setup.ts; s=$?; bun run eval:ratchet; r=$?; test $s -ne 0 && exit $s; exit $r",
    "test:eval": "bun test test/eval test/guards test/verify --preload ./test/eval/setup.ts --preload ./test/guards/setup.ts --preload ./test/verify/setup.ts",
    "merge:evidence": "bun scripts/eval-merge-evidence.ts",
    "eval:ratchet": "bun test/eval/ratchet-run.ts",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "22",
    "@earendil-works/pi-ai": "0.81.0",
    "@earendil-works/pi-coding-agent": "0.81.0",
    "@runecraft/taskflow-mcp-core": "0.2.6",
    "@runecraft/taskflow-hosts": "0.2.6",
    "@runecraft/taskflow-codex": "0.2.6",
    "@runecraft/taskflow-claude": "0.2.6",
    "@runecraft/taskflow-opencode": "0.2.6",
    "@runecraft/taskflow-grok": "0.2.6"
  },
  "bin": {
    "companion": "./bin/harness.ts",
    "harness": "./bin/harness.ts"
  },
  "dependencies": {
    "@runecraft/subagents": "0.37.2",
    "@runecraft/taskflow-core": "0.2.6",
    "@runecraft/taskflow": "0.2.6",
    "@runecraft/taskflow-dsl": "0.2.6",
    "@runecraft/goal-loop-audit": "0.28.34",
    "@runecraft/pr-review": "1.11.4",
    "jiti": "2.7.0",
    "typescript": "^6.0.3",
    "yaml": "2.8.3"
  },
  "bundledDependencies": [
    "@runecraft/subagents",
    "@runecraft/taskflow-core",
    "@runecraft/taskflow",
    "@runecraft/taskflow-dsl",
    "@runecraft/goal-loop-audit",
    "@runecraft/pr-review"
  ],
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/harness-status.ts",
      "./extensions/guards.ts",
      "./extensions/resilience.ts",
      "./extensions/observability.ts",
      "./extensions/memory.ts",
      "./extensions/persona.ts",
      "./extensions/routing.ts",
      "node_modules/@runecraft/subagents/index.ts",
      "node_modules/@runecraft/taskflow/dist/index.js",
      "node_modules/@runecraft/goal-loop-audit/extensions/loops/goal.ts",
      "node_modules/@runecraft/pr-review/extensions/index.ts"
    ],
    "skills": [
      "node_modules/@runecraft/subagents/skills",
      "node_modules/@runecraft/taskflow/skills",
      "./skills/using-runes",
      "./skills/skill-forge",
      "./skills/test-driven-development",
      "./skills/using-agent-skills",
      "./skills/memory-management",
      "./skills/spec-driven"
    ],
    "prompts": [
      "node_modules/@runecraft/subagents/prompts",
      "node_modules/@runecraft/pr-review/prompts"
    ],
    "subagents": {
      "chains": [
        "./assets/sdd/chains",
        "./chains"
      ]
    }
  }
}

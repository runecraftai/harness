{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmitOnError": false,
    "types": [
      "node"
    ],
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"]
}

{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true,
    "types": [
      "node"
    ],
    "noUncheckedIndexedAccess": false,
    "noImplicitAny": false,
    "noImplicitOverride": false,
    "strictNullChecks": false,
    "noEmitOnError": false
  },
  "include": [
    "src/**/*.ts"
  ]
}
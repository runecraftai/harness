{
	"name": "harness",
	"private": true,
	"version": "0.0.0",
	"description": "Runecraft Harness — multi-agent harness for the Pi coding agent",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"packages/*",
		"packages/taskflow/*"
	],
	"scripts": {
		"build": "turbo build",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "turbo test",
		"eval:e2e": "bun scripts/eval-e2e/run.ts",
		"test:eval-e2e": "bun test scripts/eval-e2e"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"turbo": "^2.5.0"
	},
	"engines": {
		"node": ">=22.19.0",
		"bun": ">=1.3.0"
	}
}
